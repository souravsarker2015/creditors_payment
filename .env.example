# Copy to .env and fill in. .env is git-ignored; real environment variables win over it.

# Gmail SMTP (password reset and account emails). Use a Gmail App Password,
# not the account password: https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-16-letter-app-password
DEFAULT_FROM_EMAIL=FinTrack <you@gmail.com>
# Optional (these are the defaults):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True

# Production (config.settings.prod)
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=example.com
# DB_NAME= DB_USER= DB_PASSWORD= DB_HOST= DB_PORT=
